{
  "name": "whish-pay",
  "version": "1.2.0",
  "description": "Unofficial Whish Money payment client for Node.js — type-safe, zero dependencies",
  "author": "Zaytoun Solutions <info@zaytounsolutions.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "keywords": [
    "whish",
    "whish-money",
    "whish-pay",
    "payment",
    "payment-gateway",
    "lebanon",
    "lbp",
    "usd",
    "aed",
    "e-wallet",
    "fintech",
    "checkout"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mohammad-AlBaker-Zaytoun/whish-pay.git"
  },
  "bugs": {
    "url": "https://github.com/Mohammad-AlBaker-Zaytoun/whish-pay/issues"
  },
  "homepage": "https://github.com/Mohammad-AlBaker-Zaytoun/whish-pay#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  }
}
